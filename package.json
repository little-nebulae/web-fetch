{
  "name": "@little-nebulae/web-fetch",
  "version": "0.2.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@little-nebulae/error": "1.4.1",
    "@little-nebulae/http": "0.2.0",
    "@little-nebulae/json": "0.5.1",
    "@little-nebulae/result": "1.4.0",
    "@little-nebulae/utility-types": "0.4.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "type-fest": "5.10.0",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@little-nebulae/error": "^1.0.0",
    "@little-nebulae/http": "^0.1.0",
    "@little-nebulae/json": "^0.1.0",
    "@little-nebulae/result": "^1.0.0",
    "@little-nebulae/utility-types": "0",
    "type-fest": "^5.0.0",
    "zod": "^4.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "warn"
    }
  }
}
